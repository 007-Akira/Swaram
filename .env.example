APP_ENV=development
DATABASE_URL=postgresql+psycopg://swaram:swaram@localhost:5432/swaram
CORS_ORIGINS='["http://localhost:3000"]'
PRIVATE_DATA_ROOT=./data
PRIVATE_PROTOTYPE_MEDIA_ROOT=./private-media
WORKER_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=120
STEM_DEVICE=cpu
AUDIO_MAX_BYTES=104857600
AUDIO_MAX_DURATION_SECONDS=900
DECODED_AUDIO_MAX_BYTES=209715200
FFMPEG_TIMEOUT_SECONDS=120
DEMUCS_TIMEOUT_SECONDS=1800
UPLOAD_MAX_BYTES=104857600
MAX_AUDIO_ASSETS_PER_SESSION=3
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_RETENTION_HOURS=24
OPERATIONS_TOKEN=replace-with-at-least-32-random-characters
